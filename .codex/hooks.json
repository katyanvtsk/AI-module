{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/react/task-board-starter/.codex/hooks/protect-file.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node D:/react/task-board-starter/.codex/hooks/protect-main.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "command": "node D:/react/task-board-starter/.codex/hooks/check-edited-file.cjs",
            "timeout": 40,
            "type": "command"
          }
        ]
      }
    ]
  }
}
